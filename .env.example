# ============================================================
# neotrade.pro Referral Bot — Contoh Konfigurasi
# Salin file ini ke .env lalu isi nilainya
# JANGAN pernah commit .env ke git!
# ============================================================

# Seed phrase 12/24 kata (BIP-39).
# Bisa dikosongkan — generate lewat menu 1.
MNEMONIC=

# Kode invite/referral dari URL app.neotrade.pro/?invite=<CODE>
INVITE_CODE=

# Jumlah wallet HD yang diproses (index 0 sampai MAX_INDEX-1)
MAX_INDEX=50

# Jeda antar wallet dalam milidetik
DELAY_MS=5000

# Base URL target (ganti jika staging/lokal)
BASE_URL=https://app.neotrade.pro

# Set 1 untuk log detail, kosongkan untuk log minimal
VERBOSE=1
